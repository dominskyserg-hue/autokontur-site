# Строка подключения к Supabase Postgres — Project Settings → Database →
# Connection string → URI. Рекомендуется брать через Connection Pooler
# (порт 6543), а не напрямую (порт 5432) — иначе при деплое на serverless
# (Vercel и т.п.) можно быстро упереться в лимит подключений Supabase.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres
