# Строка подключения к Supabase Postgres — Project Settings → Database →
# Connection string → URI. Рекомендуется брать через Connection Pooler
# (порт 6543), а не напрямую (порт 5432) — иначе при деплое на serverless
# (Vercel и т.п.) можно быстро упереться в лимит подключений Supabase.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres

# Единый пароль для входа в админ-панель (/admin) — проверяется в
# middleware.ts и app/api/admin/login/route.ts. Без этой переменной
# админ-панель ПОЛНОСТЬЮ недоступна (в том числе и самому админу) —
# так задумано: лучше временно недоступная панель, чем случайно
# незапароленная. Смена пароля = смена этого значения + передеплой.
ADMIN_PASSWORD=

# Секрет для защиты фоновой очереди поиска фото товаров
# (app/api/cron/fetch-product-images/route.ts) от постороннего вызова —
# Vercel Cron сам подставляет этот секрет в заголовок Authorization при
# вызове по расписанию (см. vercel.json), поэтому вручную дёргать
# роут может только тот, кто знает это значение. Сгенерировать можно
# любой случайной строкой, например командой в терминале:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Токен для сохранения фото товаров в Vercel Blob (lib/imageStorage.ts) —
# Vercel Dashboard → проект → Storage → Create Database → Blob → привязать
# к проекту. Vercel сам добавит этот токен в переменные окружения проекта
# (Production) — для локальной разработки нужно скопировать то же значение
BLOB_READ_WRITE_TOKEN=

# Google Analytics 4 — analytics.google.com → Адмін → Потоки даних →
# ваш потік → "Ідентифікатор потоку" (вигляд G-XXXXXXXXXX).
# Префікс NEXT_PUBLIC_ обов'язковий — без нього значення не потрапить
# у код, що виконується в браузері (див. коментар в кінці app/layout.tsx)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console — search.google.com/search-console → додати
# ресурс → "Файл HTML-тега" → скопіювати ЛИШЕ значення content="..."
NEXT_PUBLIC_GSC_VERIFICATION=

# Meta (Facebook) Pixel — business.facebook.com → Events Manager →
# выбрать пиксель → Настройки → "ID пикселя" (число из 15-16 цифр).
# Без префикса NEXT_PUBLIC_ значение не попадёт в код, выполняющийся
# в браузере (см. пояснение в конце app/layout.tsx)
NEXT_PUBLIC_META_PIXEL_ID=

# ------------------------------------------------------------
# Автозагрузка прайсов из почты (lib/emailPriceImport.ts) —
# панель "Автозагрузка прайсов по email" в Настройках админки.
# Без EMAIL_IMAP_USER/EMAIL_IMAP_PASSWORD автозагрузка просто
# выключена (ни cron, ни кнопка "Проверить сейчас" ничего не делают).
# ------------------------------------------------------------

# Адрес почтового ящика, который принимает прайсы от поставщиков.
# Для Gmail — обычный адрес вида shop@gmail.com
EMAIL_IMAP_USER=

# Пароль для этого ящика. ВАЖНО: для Gmail это НЕ обычный пароль от
# аккаунта, а отдельный "пароль приложения" (App Password) — обычный
# пароль Google для IMAP не примет:
#   1. Включите двухфакторную аутентификацию (без неё пароли приложений
#      недоступны) — myaccount.google.com/security
#   2. Создайте пароль приложения — myaccount.google.com/apppasswords
#      → "Приложение": Почта, "Устройство": свой компьютер → Создать
#   3. Google покажет пароль из 16 символов (например, abcd efgh ijkl mnop) —
#      скопируйте его сюда БЕЗ пробелов
EMAIL_IMAP_PASSWORD=

# Адрес и порт IMAP-сервера. По умолчанию — Gmail (imap.gmail.com:993).
# Меняйте, только если почта не на Gmail (например, у своего хостинга)
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993

# API-ключ Нової Пошти (my.novaposhta.ua → Налаштування → API) — для
# пошуку міст і відділень у кошику (app/api/nova-poshta/*.ts). НЕ
# NEXT_PUBLIC_: запити до api.novaposhta.ua йдуть тільки з сервера,
# ключ ніколи не потрапляє в браузер
NOVA_POSHTA_API_KEY=

# ------------------------------------------------------------
# Сповіщення про нове замовлення в Telegram (lib/telegramNotify.ts) —
# спрацьовує з app/api/orders/create/route.ts одразу після оформлення
# замовлення покупцем. Без обох значень нижче сповіщення просто тихо
# не відправляється, оформлення замовлення це ніяк не блокує.
#
# Як отримати:
#   1. Написати @BotFather в Telegram → /newbot → скопіювати токен
#   2. Написати створеному боту будь-яке повідомлення (або додати його
#      в груповий чат) — боти не можуть писати першими
#   3. Відкрити https://api.telegram.org/bot<ТОКЕН>/getUpdates і
#      знайти "chat":{"id": ...} — це і є TELEGRAM_CHAT_ID
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
